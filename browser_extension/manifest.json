{
  "manifest_version": 3,
  "name": "Tab Audio Recorder",
  "version": "1.6",
  "description": "Записывает аудио любой вкладки и отправляет на сервер",
  "permissions": ["tabCapture", "activeTab", "scripting", "offscreen"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_icon": {
      "128": "icons/icon.png"
    },
    "default_title": "Начать/остановить запись аудио вкладки"
  },
  "web_accessible_resources": [
    {
      "resources": ["offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ]
}